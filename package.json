{
  "name": "desktop-course-widget",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:time-flow": "node scripts/check-time-flow.mjs",
    "check:import-review": "node --experimental-strip-types --test scripts/import-review.test.ts",
    "check:screenshot-import": "node --experimental-strip-types --test scripts/screenshot-import-policy.test.ts scripts/runtime-capabilities.test.ts",
    "check:import-review-dom": "node scripts/check-import-review-dom.mjs",
    "check:screenshot-import-dom": "node scripts/check-screenshot-import-dom.mjs",
    "check:presentation-clock": "node --experimental-strip-types scripts/check-presentation-clock.mjs",
    "check:security-boundary": "node --experimental-strip-types --test scripts/tauri-security-policy.test.mjs scripts/widget-hide-lifecycle.test.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-window-state": "^2.4.1"
  }
}
