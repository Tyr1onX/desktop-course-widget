{
  "name": "course-widget-promo-video",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic promo video compositions for 课刻.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "render:logo": "remotion render src/index.ts LogoFormation out/logo-formation.mp4 --codec=h264 --crf=16",
    "still:logo": "remotion still src/index.ts LogoFormation out/logo-formation.png --frame=132"
  },
  "dependencies": {
    "@remotion/cli": "4.0.468",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.468"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
